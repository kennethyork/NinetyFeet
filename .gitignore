# Godot's own build and import cache
.godot/
.import/

# Exported builds and the packaged downloads. Hundreds of megabytes of binaries
# that are reproducible from the source beside them, which is not what a
# repository is for.
build/
dist/

# .NET intermediates
bin/
obj/

# Godot rewrites the csproj when it upgrades the SDK and leaves the previous one
# beside it. Useful for a moment, not for ever.
*.csproj.old*

# The AppDir is a staging folder rebuilt from the export every time.
build/NinetyFeet.AppDir/
