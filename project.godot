; Engine configuration file.
; Ninety Feet — arcade baseball on an honest simulation, with 32 clubs.

config_version=5

[application]

config/name="Ninety Feet"
config/description="Arcade baseball on an honest simulation. 32 clubs, a real front office, and a race to ninety feet."
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7.1", "C#", "Forward Plus")
config/icon="res://icon.svg"
; Renaming the game moves user:// with it, because Godot derives that path from
; config/name. The existing season and card collection were copied across by hand
; when the name changed; nothing else needs doing.

[autoload]

NetLink="*res://Scenes/Autoload/NetLink.tscn"
Game="*res://Scenes/Autoload/Game.tscn"
Sfx="*res://Scenes/Autoload/Sfx.tscn"
Narrator="*res://Scenes/Autoload/Narrator.tscn"
Music="*res://Scenes/Autoload/Music.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
; Every screen is composed against 1280x720. "expand" hands the layout the window's real
; aspect instead of letterboxing, so the game fills whatever it is given — a wider window
; gains grass either side, a taller one gains sky and dirt, and neither ever takes room away.
;
; It was pinned to "keep" because expand scattered the batting view, and that was true: the
; horizon, the mound and the wall were fractions of the window while the plate, the zone and
; the batter hung off a fixed pixel offset, so the two halves of the composition drifted apart
; as the shape changed. UI.Layout centres the composition in a design-sized stage and lets only
; the backdrops fill, which is what makes expand safe here.
window/stretch/aspect="expand"

; A phone held upright would show a ballfield in a letterbox with a control pad on top
; of it. The game is composed sideways and stays sideways.
window/handheld/orientation=1

[dotnet]

project/assembly_name="SandlotSlugfest"

[rendering]

; Android will not take a project without it. Almost nothing here is a texture — the game
; draws its art at runtime — so this costs two icons' worth of import time.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.13, 1)
